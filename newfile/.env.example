# ==============================================================================
# RAG INGESTION PIPELINE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Copy this file to .env and fill in your actual values

# --- GEMINI API (Embeddings) ---
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- QDRANT VECTOR DATABASE ---
# Sign up at: https://cloud.qdrant.io/
# Example: https://your-instance-url-xxxxx.us-east-1-0.aws.qdrant.io:6333
QDRANT_CLUSTER_ENDPOINT=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=documents

# --- CHUNKING CONFIGURATION ---
# Size of each chunk in characters
CHUNK_SIZE=1000
# Overlap between consecutive chunks
CHUNK_OVERLAP=200

# --- GROQ API (Optional - for generation) ---
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=optional_groq_api_key
GROQ_FALLBACK_API_KEY=optional_groq_fallback_key
GROQ_MODEL=mixtral-8x7b-32768

# --- LOGFIRE OBSERVABILITY (Optional) ---
# Get your token from: https://logfire.pydantic.dev/
LOGFIRE_TOKEN=optional_logfire_token
LOGFIRE_SERVICE_NAME=rag-production-grade
ENVIRONMENT=development

# --- DATA DIRECTORY ---
# Where to store local embeddings (JSON files)
# Leave unset to use default ./DATA directory
# DATA_DIR=./DATA
