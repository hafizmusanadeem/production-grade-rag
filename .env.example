```dotenv
# ==============================================================================
# RAG INGESTION PIPELINE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and replace placeholders with your actual credentials.

# --- GROQ API (LLM Generation) ---
GROQ_API_KEY=your_groq_api_key
GROQ_FALLBACK_API_KEY=your_groq_fallback_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# --- QDRANT VECTOR DATABASE ---
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_CLUSTER_ENDPOINT=https://your-cluster.eu-west-1-0.aws.cloud.qdrant.io
QDRANT_COLLECTION=rag-collection

# Ingestion and search timeouts (seconds)
QDRANT_INGEST_TIMEOUT_SECONDS=120
QDRANT_SEARCH_TIMEOUT_SECONDS=10

# Upsert and retry configuration
QDRANT_UPSERT_BATCH_SIZE=5
QDRANT_MAX_RETRIES=3
QDRANT_RETRY_BASE_DELAY_SECONDS=2.0

# --- GEMINI API (Embeddings) ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- LOGFIRE OBSERVABILITY ---
LOGFIRE_TOKEN=your_logfire_token
LOGFIRE_SERVICE_NAME=starter-project
ENVIRONMENT=development

# --- PORTKEY (LLM Gateway / Fallback Configuration) ---
PORTKEY_API_KEY=your_portkey_api_key
PORTKEY_SLUG_1=your_primary_slug
PORTKEY_SLUG_2=your_fallback_slug
PORTKEY_CONFIG_ID=your_portkey_config_id

# --- CHUNKING CONFIGURATION ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- DATA DIRECTORY ---
# Leave unset to use the default ./DATA directory.
# DATA_DIR=./DATA
```
